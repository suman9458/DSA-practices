#include<iostream>
using namespace std;

int missing(int arr[],int size){
    int sum=(size+1)* (size+2)/2;

    int actual=0;
    for(int i=0;i<size;i++){
        actual+=arr[i];
    }
    return sum-actual;
}

int main(){
    int arr[5]={1,3,4,5,6};
    int n=5;
    missing(arr,n);
     int ans = missing(arr, n);
    cout << "Missing number is: " << ans;
}